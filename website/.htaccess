# Legacy CloudLinux Passenger (unused on VPS nginx — kept commented)
# PassengerAppRoot "/home/seokurs1/api"
# PassengerBaseURI "/app"
# PassengerNodejs "/home/seokurs1/nodevenv/api/18/bin/node"
# PassengerAppType node
# PassengerStartupFile app.js

# Включаем mod_rewrite
RewriteEngine On

# Канонические URL без завершающего слеша для псевдо-роутов
# Иначе относительные пути (styles.css, script.js, logo.png) ломаются на /en/ и /top/
RewriteRule ^en/$ /en [R=301,L]
RewriteRule ^top/$ /top [R=301,L]
RewriteRule ^player/([^/]+)/$ /player/$1 [R=301,L]

# Правильный Content-Type для Universal Links (важно для iOS!)
<FilesMatch "apple-app-site-association">
    Header set Content-Type "application/json"
</FilesMatch>

<FilesMatch "assetlinks.json">
    Header set Content-Type "application/json"
</FilesMatch>

# Редирект /en на index-en.html для английской версии
RewriteRule ^en/?$ index-en.html [L]

# Редирект /top на страницу рейтинга приглашений
RewriteRule ^top/?$ top.html [L]

# XML sitemaps (index + static + players)
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^sitemap-static\.xml$ sitemap-static.php [L]
RewriteRule ^sitemap-players\.xml$ sitemap-players.php [L]

# Редирект /player/{id} на player.php с параметром id
# Поддерживает оба варианта: /player/{id} и /player/{id}/
RewriteRule ^player/([^/]+)/?$ player.php?id=$1 [L,QSA]

# Если запрашивается /player без ID, редиректим на главную
RewriteRule ^player/?$ / [R=301,L]

