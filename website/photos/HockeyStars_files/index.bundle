          resize: {
            width: 600
          }
        }],
        // Уменьшаем до 600px по ширине
        {
          compress: 1.0,
          // Без сжатия для PNG
          format: ImageManipulator.SaveFormat.PNG // Сохраняем как PNG для прозрачности
