        "benefits": [
          "Uzlabo sirds un asinsvadu izturību",
          "Attīsta aerobo izturību",
          "Efektīvi sadedzina kalorijas",
          "Stiprina sirds muskuli"
        ],
        "instructions": [
          "Sāciet ar vieglu iesildīšanos 5-10 minūšu garumā",
          "Saglabājiet savu mērķa sirdsdarbības ātrumu",
          "Vērojiet savu elpošanu - elpojiet dziļi",
          "Pabeidziet ar atdzesēšanu un izstiepiet."
        ],
        "tips": [
          "Pakāpeniski palieliniet ilgumu",
          "Treniņa laikā dzeriet ūdeni.",
          "Veikt 3-4 reizes nedēļā",
          "Klausieties savu ķermeni"
        ]
      },
