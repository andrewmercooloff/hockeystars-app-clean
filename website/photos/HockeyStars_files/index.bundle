    "items": {
      "1": {
        "title": "Intervalový běh",
        "description": "Střídání rychlého běhu (30 sekund) a pomalého běhu (30 sekund) po dobu 20 minut. Vynikající pro rozvoj kardio vytrvalosti pro hokej.",
        "equipment": "Běžecký pás nebo stadion",
        "calories": "250-350 kcal",
        "benefits": [
