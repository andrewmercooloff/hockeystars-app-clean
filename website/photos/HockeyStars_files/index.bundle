    "items": {
      "1": {
        "title": "Intervalinis bėgimas",
        "description": "20 minučių pakaitomis greitai (30 sekundžių) ir lėtai (30 sekundžių). Puikiai tinka lavinti širdies ištvermę ledo rituliui.",
        "benefits": [
          "Pagerina širdies ir kraujagyslių sistemos ištvermę",
          "Lavina gebėjimą greitai atsigauti",
          "Pagerina bendrą fizinį pasirengimą",
          "Imituoja ledo ritulio rungtynių įtampą"
        ],
        "instructions": [
          "Pradėkite nuo 5 minučių apšilimo lengvo bėgiojimo",
          "Greitai bėgkite 30 sekundžių (80–90% maksimalaus greičio)",
          "Norėdami atsigauti, pereikite prie 30 sekundžių lėto bėgiojimo",
          "Pakartokite ciklą 20-25 kartus",
          "Užbaikite 5 minučių atvėsimu"
        ],
        "tips": [
          "Stebėkite kvėpavimą – kvėpuokite giliai ir ritmingai",
          "Neviršykite 90% didžiausio greičio",
          "Jei esate pavargęs, galite pailginti atsigavimo laiką.",
          "Atlikite 2-3 kartus per savaitę"
        ],
        "equipment": "Bėgimo takelis arba stadionas",
        "calories": "250-350 kcal"
      },
      "2": {
        "title": "Burpee šuolis",
        "description": "Sudėtingas pratimas: pritūpimas → lenta → atsispaudimas → pritūpimas → šuolis. Atlikite 3 rinkinius po 10-15 pakartojimų.",
        "benefits": [
          "Lavina bendrą ištvermę",
          "Stiprina viso kūno raumenis",
          "Pagerina judesių koordinaciją",
          "Padidina sprogstamąją galią"
        ],
        "instructions": [
          "Atsistokite tiesiai, kojos pečių plotyje",
          "Pritūpkite delnais ant grindų priešais save.",
          "Stumkite kojas atgal į lentos padėtį",
          "Atlikite vieną atsispaudimą",
          "Patraukite kojas atgal link rankų, išlikdami pritūpimo padėtyje.",
          "Šokinėkite aukštyn, pakelkite rankas virš galvos",
          "Švelniai nusileiskite ir pakartokite."
        ],
        "tips": [
          "Viso pratimo metu laikykite nugarą tiesiai.",
          "Nusileiskite sulenkę kojas",
          "Pradėkite nuo 5-8 pakartojimų ir palaipsniui didinkite",
          "Tarp rinkinių pailsėkite 60-90 sekundžių"
        ],
        "equipment": "Mankštos kilimėlis (neprivaloma)",
        "calories": "200-300 kcal"
      },
      "3": {
        "title": "Dviratis",
        "description": "Intensyvus važiavimas dviračiu arba nejudantis dviratis su didelio intensyvumo intervalais. 5 minutės apšilimo, 20 minučių pertraukos.",
        "benefits": [
          "Lavina kardio ištvermę",
          "Stiprina kojų raumenis",
          "Sudegina daug kalorijų",
          "Mažas krūvis sąnariams"
        ],
        "instructions": [
          "5 minutės žemo intensyvumo apšilimo",
          "2 minutės didelio intensyvumo (80–85 % maksimalaus)",
          "1 minutės atsigavimas esant žemam intensyvumui",
          "Pakartokite intervalus 10 kartų",
          "5 minutes žemo intensyvumo atvėsinkite"
        ],
        "tips": [
          "Palaikykite aukštą pedalo spaudimo ritmą (80-100 aps./min.)",
          "Stebėkite savo kūno padėtį – laikykite nugarą tiesiai",
          "Sureguliuokite pasipriešinimą, kad pakeistumėte intensyvumą",
          "Treniruotės metu gerkite vandenį."
        ],
        "equipment": "Dviratis arba treniruoklis",
        "calories": "300-400 kcal"
      },
      "4": {
        "title": "Pliometriniai šuoliai",
        "description": "Šokinėjimas vietoje kuo aukščiau, nusileidimas ant sulenktų kelių. 3 15-20 šuolių rinkiniai.",
        "benefits": [
          "Lavina sprogstamą kojų jėgą",
          "Pagerina reakciją ir greitį",
          "Stiprina sausgysles ir raiščius",
          "Padidina vertikalų šuolį"
        ],
        "instructions": [
          "Atsistokite tiesiai, kojos pečių plotyje",
          "Pritūpkite 1/4 kelio sulenkę kelius",
          "Sprogiai šokinėkite aukštyn, ištieskite rankas",
          "Nusileiskite sulenkę kojas",
          "Nedelsdami atlikite kitą šuolį",
          "Atlikite 15-20 šuolių iš eilės"
        ],
        "tips": [
          "Švelniai nusileiskite, sulenkite kelius.",
          "Laikykite savo kūną tiesiai",
          "Nedarykite pertraukų tarp šuolių",
          "Tarp rinkinių pailsėkite 2-3 minutes"
