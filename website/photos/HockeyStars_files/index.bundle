      const accountSid = Constants.default.expoConfig?.extra?.twilioAccountSid;
      const authToken = Constants.default.expoConfig?.extra?.twilioAuthToken;
      const twilioPhoneNumber = Constants.default.expoConfig?.extra?.twilioFromNumber;
      if (!accountSid || !authToken || !twilioPhoneNumber) {
