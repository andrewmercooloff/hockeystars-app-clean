          "Отожмитесь вверх, разгибая руки",
          "Выполните 3-4 подхода по 5-15 повторений"
        ],
        "tips": [
          "Держите корпус прямым",
          "Не раскачивайтесь",
          "Опускайтесь до комфортной глубины",
          "При необходимости используйте помощь ног"
        ]
      },
      "46": {
        "title": "Стойка на одной ноге",
        "instructions": [
          "Встаньте на одну ногу",
          "Поднимите другую ногу перед собой",
          "Держите равновесие как можно дольше",
          "Работайте руками для баланса",
          "Поменяйте ноги и повторите"
        ],
        "tips": [
          "Смотрите вперед, не вниз",
          "Держите корпус напряженным",
          "Начинайте с коротких подходов",
          "Постепенно увеличивайте время"
        ]
      },
      "47": {
        "title": "Планка на одной ноге",
        "instructions": [
          "Примите положение планки",
          "Поднимите одну ногу вверх",
          "Держите ногу прямой",
          "Удерживайте позицию 30-60 секунд",
          "Поменяйте ноги и повторите"
        ],
        "tips": [
          "Держите корпус прямым",
          "Не раскачивайтесь из стороны в сторону",
          "Дышите равномерно",
          "Начинайте с коротких подходов"
        ]
      },
      "48": {
        "title": "Приседания на одной ноге",
        "instructions": [
          "Встаньте на одну ногу",
          "Другую ногу вытяните вперед",
          "Приседайте на опорной ноге",
          "Вернитесь в исходное положение",
          "Выполните 3-4 подхода по 5-10 повторений на каждую ногу"
        ],
        "tips": [
          "Держите спину прямой",
          "Не касайтесь пола второй ногой",
          "Работайте руками для баланса",
          "Начинайте с небольшой амплитуды"
        ]
      },
      "49": {
        "title": "Босу-мяч упражнения",
        "instructions": [
          "Встаньте на полусферу босу-мяч",
          "Держите равновесие",
          "Выполняйте приседания",
          "Делайте повороты корпуса",
          "Выполните 3-4 подхода по 10-15 повторений"
        ],
        "tips": [
          "Начинайте с простых упражнений",
          "Следите за техникой",
          "Не торопитесь",
          "Используйте помощь для поддержки"
        ]
      },
      "50": {
        "title": "Йога-баланс",
        "instructions": [
          "Встаньте прямо, ноги вместе",
          "Поднимите одну ногу и поставьте на бедро другой",
          "Сложите руки перед грудью",
          "Держите равновесие",
          "Выполните для обеих ног по 30-60 секунд"
        ],
        "tips": [
          "Смотрите вперед в одну точку",
          "Дышите глубоко и равномерно",
          "Не торопитесь",
          "При потере баланса начните заново"
        ]
      },
      "51": {
        "title": "Ходьба по бревну",
        "instructions": [
          "Найдите устойчивое бревно или доску",
          "Встаньте на бревно",
          "Идите медленно вперед",
          "Держите равновесие",
          "Выполните несколько проходов"
        ],
        "tips": [
          "Начинайте с широкого бревна",
          "Смотрите вперед, а не вниз",
          "Работайте руками для баланса",
          "Не торопитесь"
        ]
      },
      "52": {
        "title": "Стойка на руках у стены",
        "instructions": [
          "Встаньте лицом к стене",
          "Поставьте руки на пол на расстоянии 30 см от стены",
          "Поднимите ноги вверх по стене",
          "Держите стойку на руках",
          "Опустите ноги контролируемо"
        ],
        "tips": [
          "Начинайте с коротких подходов",
          "Используйте помощь для страховки",
          "Держите корпус напряженным",
          "Не перенапрягайтесь"
        ]
      },
      "53": {
        "title": "Фартлек",
        "instructions": [
          "Начните с медленного бега 5-10 минут",
          "Увеличьте скорость до 80% от максимальной на 2-3 минуты",
          "Вернитесь к медленному бегу на 1-2 минуты",
          "Повторите цикл 4-6 раз",
          "Завершите медленным бегом 5-10 минут"
        ],
        "tips": [
          "Слушайте свое тело",
          "Не превышайте 80% от максимальной скорости",
          "Дышите глубоко",
          "Пейте воду во время тренировки"
        ]
      },
      "54": {
        "title": "Повторные спринты",
        "instructions": [
          "Выполните 10-минутную разминку",
          "Пробегите спринт на максимальной скорости 30 секунд",
          "Отдохните 2-3 минуты",
          "Повторите спринт",
          "Выполните 6-8 спринтов"
        ],
        "tips": [
          "Не экономьте на разминке",
          "Отдыхайте полностью между спринтами",
          "Следите за техникой бега",
          "Не тренируйтесь ежедневно"
        ]
      },
      "55": {
        "title": "Интервалы на велосипеде",
        "instructions": [
          "Начните с 5-минутной разминки",
          "Увеличьте нагрузку до 80% от максимальной",
          "Крутите педали с высокой интенсивностью 2-3 минуты",
          "Снизьте нагрузку до 50% на 1-2 минуты",
          "Повторите цикл 6-8 раз"
        ],
        "tips": [
          "Поддерживайте высокий каденс",
          "Дышите глубоко",
          "Следите за пульсом",
          "Пейте воду регулярно"
        ]
      },
      "56": {
        "title": "Бег по холмам",
        "instructions": [
          "Найдите холм с уклоном 5-10%",
          "Выполните 10-минутную разминку",
          "Бегите вверх по холму с умеренной скоростью",
          "Спускайтесь вниз для восстановления",
          "Повторите 6-10 подъемов"
        ],
        "tips": [
          "Начинайте с небольшого уклона",
          "Держите спину прямой при подъеме",
          "Работайте руками активно",
          "Не торопитесь на спуске"
        ]
      },
      "57": {
        "title": "Плиометрические круги",
        "instructions": [
          "Выполните 10-минутную разминку",
          "Сделайте прыжки в длину с места",
          "Выполните прыжки через препятствия",
          "Сделайте прыжки на ящик",
          "Отдохните 2-3 минуты и повторите круг"
        ],
        "tips": [
          "Следите за техникой приземления",
          "Приземляйтесь на полусогнутые ноги",
          "Работайте руками для баланса",
          "Не переусердствуйте с количеством"
        ]
      },
      "58": {
        "title": "Легкая растяжка",
        "instructions": [
          "Начните с легких движений",
          "Выполните растяжку основных мышечных групп",
          "Дышите глубоко и равномерно",
          "Двигайтесь плавно и медленно",
          "Завершите глубоким дыханием"
        ],
        "tips": [
          "Не растягивайтесь до боли",
          "Дышите глубоко",
          "Расслабляйтесь полностью",
          "Выполняйте регулярно"
        ]
      },
      "59": {
        "title": "Фоам-роллинг",
        "instructions": [
          "Лягте на фоам-роллер",
          "Медленно катайте роллер под мышцами",
          "Остановитесь на болезненных точках",
          "Держите давление 30-60 секунд",
          "Повторите для всех групп мышц"
        ],
        "tips": [
          "Не катайте по суставам",
          "Дышите глубоко",
          "Не терпите сильную боль",
          "Начинайте с мягкого роллера"
        ]
      },
