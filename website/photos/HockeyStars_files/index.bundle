          "Pašalina raumenų įtampą",
          "Padidina judesių diapazoną"
        ],
        "instructions": [
          "Pasirinkite tinkamą elastinę juostą",
          "Atlikite lėtus judesius",
          "Laikykite tempimą 20-30 sekundžių",
          "Kiekvieną pratimą kartokite 3-5 kartus"
        ],
        "tips": [
          "Pradėkite nuo lengvos elastinės juostos",
          "Neleisk, kad skaudėtų",
          "Kvėpuokite tolygiai",
          "Palaipsniui didinkite pasipriešinimą"
        ],
        "equipment": "Guminė juosta",
        "calories": "35-55 kcal"
      },
      "65": {
        "title": "Kontrastinis dušas",
        "description": "Kaitinamas karštas ir šaltas vanduo, siekiant pagerinti cirkuliaciją ir atsigavimą. 5-7 minutes.",
        "benefits": [
          "Padidina raumenų jėgą",
          "Pagerina raumenų ištvermę",
          "Lavina funkcinę jėgą",
          "Stiprina raumenų ir kaulų sistemą"
        ],
        "instructions": [
          "Prieš mankštą apšilkite",
          "Įsitikinkite, kad naudojate tinkamą techniką",
          "Kontroliuokite kvėpavimą – iškvėpkite su pastangomis",
          "Tarp rinkinių pailsėkite 60-90 sekundžių."
        ],
        "tips": [
          "Pradėkite nuo lengvesnių svorių ir palaipsniui didinkite.",
          "Nelaikykite kvėpavimo",
          "Atlikite 2-3 kartus per savaitę",
          "Sumažinkite krūvį, kai jaučiatės pavargę"
        ]
      }
    }
  },
