          "Lavina aerobinę ištvermę",
          "Veiksmingai degina kalorijas",
          "Stiprina širdies raumenį"
        ],
        "instructions": [
          "Pradėkite nuo lengvo 5-10 minučių apšilimo",
          "Išlaikykite tikslinį širdies ritmą",
          "Stebėkite kvėpavimą – kvėpuokite giliai",
          "Baigti atvėsinti ir ištempti."
        ],
        "tips": [
