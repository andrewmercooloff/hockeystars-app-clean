        } = await require(_dependencyMap[7], "expo/internal/async-require-module")(_dependencyMap[9], _dependencyMap.paths, "./notificationService");

        // Дополнительная проверка: отправитель и получатель не должны быть одинаковыми
        if (senderId === receiverId) {
