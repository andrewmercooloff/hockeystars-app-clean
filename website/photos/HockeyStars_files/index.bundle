          "Bėkite maksimaliu greičiu",
          "Kad atsigautumėte, nusileiskite ėjimo tempu",
          "Atlikite 10-15 pakėlimų",
          "Tarp pakėlimų pailsėkite 1-2 minutes"
        ],
        "tips": [
          "Keldami naudokite visą pėdą.",
          "Laikykite nugarą tiesiai",
          "Aktyviai dirbkite rankomis",
          "Neviršykite savo galimybių"
        ],
        "equipment": "Kopėčios",
        "calories": "250-350 kcal"
      },
      "19": {
        "title": "Lenta su judesiais",
        "description": "Lentų laikymas su kintamu rankų ir kojų pakėlimu. 3 rinkiniai po 45-60 sekundžių šerdies stiprinimui.",
        "benefits": [
          "Padidina raumenų jėgą",
          "Pagerina raumenų ištvermę",
          "Lavina funkcinę jėgą",
          "Stiprina raumenų ir kaulų sistemą"
        ],
        "instructions": [
          "Prieš mankštą apšilkite",
          "Įsitikinkite, kad naudojate tinkamą techniką",
          "Kontroliuokite kvėpavimą – iškvėpkite su pastangomis",
          "Tarp rinkinių pailsėkite 60-90 sekundžių."
        ],
        "tips": [
          "Pradėkite nuo lengvesnių svorių ir palaipsniui didinkite.",
          "Nelaikykite kvėpavimo",
          "Atlikite 2-3 kartus per savaitę",
          "Sumažinkite krūvį, kai jaučiatės pavargę"
        ]
      },
      "20": {
        "title": "Bėgimas aukštu keliu",
        "description": "Bėgiokite vietoje, keldami kelius prie krūtinės kuo aukščiau. 5 rinkiniai po 2 minutes su 1 minutės poilsiu.",
