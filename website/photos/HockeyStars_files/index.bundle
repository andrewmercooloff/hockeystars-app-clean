      // Если администратор не найден, ищем обычного пользователя
      const {
        data,
        error
      } = await _supabase.supabase.from('players').select('*').eq('phone', phone).single();
      if (error) {
        console.error('❌ Ошибка поиска игрока:', error);
        return null;
      }
      if (data) {
        return convertSupabaseToPlayer(data);
      }
