# === Cursor Ignore File ===
# Исключаем большие папки и файлы для предотвращения OOM крашей

# Node modules (самая большая папка)
node_modules/
**/node_modules/

# Build artifacts
.expo/
dist/
build/
android/app/build/
android/.gradle/
ios/build/
ios/Pods/
*.ipa
*.aab
*.apk

# Git
.git/

# Package locks (большие файлы)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Temporary files
*.log
*.tmp
*.temp
.cache/
.parcel-cache/
metro-cache/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
*.bak

# Large media files
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.tar
*.gz
*.rar

# Documentation markdown (не критично для кода)
*.md
!README.md

# SQL dumps
*.sql

# Test coverage
coverage/

# Gradle
.gradle/
gradle/

# CocoaPods
Pods/

# Assets that don't need indexing
assets/fonts/
assets/images/*.png
assets/images/*.jpg
assets/images/*.jpeg

# Expo
.expo-shared/

# Android native
android/.idea/
android/local.properties
android/captures/

# iOS native  
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/DerivedData/

# Server (if not working on it)
server/node_modules/

# Backup files
*.backup
*.old

# Large JSON files
**/locales/*.json
